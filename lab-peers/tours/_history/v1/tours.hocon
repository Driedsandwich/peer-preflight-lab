        "parameters": {
          "type": "object",
          "properties": {
            "request": { "type": "string" }
          },
          "required": ["request"]
        }
      },
      "instructions": "Help the visitor choose a tour. Ask the itinerary agent about tours and the booking agent about reservations.",
      "tools": ["itinerary", "booking"]
    },
    {
      "name": "itinerary",
      "function": {
